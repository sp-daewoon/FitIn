# Copy to .env.development.local. Never put server secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production uses a DIFFERENT project in .env.production.local / EAS environment secrets.
# Provider readiness is read from the backend; do not advertise unconfigured providers.
# Apple team used to sign local iOS builds. Restored on every prebuild so regenerating the
# native project does not clear the team you picked in Xcode. Not a secret, but account-specific.
FITIN_APPLE_TEAM_ID=
# iOS OAuth client id from Google Cloud, e.g. 123-abc.apps.googleusercontent.com. With it, Google
# sign-in opens the native account picker instead of a browser showing the Supabase subdomain.
# Add the same id to the Supabase Google provider's authorized client ids. Optional: without it the
# browser flow still works.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
