{
  "name": "fitin",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.18",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prototype": "python3 -m http.server 4173 --bind 127.0.0.1 --directory docs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run harness:check",
    "build:web": "expo export --platform web",
    "harness:check": "node scripts/check-harness.mjs",
    "release:check": "node scripts/check-harness.mjs --release",
    "format": "prettier --write App.tsx src tests scripts",
    "format:check": "prettier --check App.tsx src tests scripts"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
